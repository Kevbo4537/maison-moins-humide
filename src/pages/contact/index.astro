---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
---
<BaseLayout
  title="Contact — Maison Moins Humide"
  description="Nous contacter pour toute question sur le site Maison Moins Humide."
  noindex
>
  <div class="container" style="padding-top:2rem;padding-bottom:3rem">
    <Breadcrumbs crumbs={[{ label: 'Accueil', href: '/' }, { label: 'Contact' }]} />
    <h1>Contact</h1>
    <p>Vous pouvez nous contacter par e-mail pour toute question, suggestion ou signalement d'erreur.</p>
    <p><strong>E-mail :</strong> <a href="mailto:contact@maisonmoinshumide.fr">contact@maisonmoinshumide.fr</a></p>
    <p>Nous répondons généralement sous 2 à 5 jours ouvrés.</p>
  </div>
</BaseLayout>
