const faqs = [
  {
    question: 'Une VMC déshumidifie-t-elle le logement ?',
    answer: 'Une VMC ne récupère pas l’eau dans un bac : elle évacue l’air intérieur humide et fait entrer de l’air neuf. Elle agit donc sur la cause fréquente qu’est le manque de renouvellement d’air.',
  },
  {
    question: 'Peut-on remplacer une VMC par un déshumidificateur ?',
    answer: 'Non. Un déshumidificateur retire de l’eau de l’air, mais ne renouvelle pas l’air du logement. Il peut servir d’appoint quand la ventilation fonctionne déjà ou dans une pièce difficile à traiter.',
  },
  {
    question: 'Que choisir pour une salle de bain sans fenêtre ?',
    answer: 'La priorité est une extraction d’air qui fonctionne et une arrivée d’air sous la porte. Un déshumidificateur ne vient qu’en appoint, après mesure, en respectant la sécurité électrique de la pièce d’eau.',
  },
