    href: 'https://amzn.to/43J24CF',
    badge: 'Pièce plus humide',
    ctaLabel: 'Voir sur Amazon →',
    imageSrc: 'https://m.media-amazon.com/images/I/61iz4zedC-L._AC_SL1500_.jpg',
  },
  {
    title: 'Meaco Arete One 12 L',
    useCase: 'Option plus premium pour une pièce de vie ou une maison où l’on veut un appareil sérieux et plus agréable au quotidien.',
    details: 'Déshumidificateur avec purification HEPA. Plus cher : intéressant si le bruit, la finition et l’usage régulier comptent.',
    href: 'https://amzn.to/4dDjgzv',
    badge: 'Premium',
    ctaLabel: 'Voir sur Amazon →',
    imageSrc: 'https://m.media-amazon.com/images/I/61HFkn33tpL._AC_SL1500_.jpg',
  },
  {
    title: 'De’Longhi Tasciugo AriaDry DEX212SF',
    useCase: 'Alternative de marque connue pour la maison, avec séchage du linge et filtration.',
    details: '12 L/24 h annoncé. À regarder si l’on veut un appareil de marque reconnue plutôt qu’un modèle premier prix.',
    href: 'https://amzn.to/4dRNOw5',
    badge: 'Marque connue',
    ctaLabel: 'Voir sur Amazon →',
    imageSrc: 'https://m.media-amazon.com/images/I/51fKBuZfhFL._AC_SL1500_.jpg',
