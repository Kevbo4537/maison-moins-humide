---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ArticleCard from '../../components/ArticleCard.astro';
const base = import.meta.env.BASE_URL;
const pieces = [
  { title: "Salle de bain humide", href: "/pieces/salle-de-bain-humide/", description: "Douches, joints noirs, plafond, extraction : les gestes qui font sécher plus vite.", badge: "Vapeur" },
  { title: "Salle de bain sans fenêtre", href: "/pieces/salle-de-bain-sans-fenetre/", description: "VMC, extracteur, porte, absorbeur : quoi faire quand la vapeur ne sort pas naturellement.", badge: "Sans fenêtre" },
  { title: "Chambre humide", href: "/pieces/chambre-humide/", description: "Condensation nocturne, odeur au réveil, murs froids et circulation d’air.", badge: "Nuit" },
  { title: "Cave humide", href: "/pieces/cave-humide/", description: "Murs enterrés, stockage, odeurs, ventilation et déshumidificateur adapté.", badge: "Stockage" },
  { title: "Placard humide", href: "/pieces/placard-humide/", description: "Vêtements qui sentent, air stagnant, mur froid et absorbeur utile ou non.", badge: "Rangement" },
  { title: "Buanderie humide", href: "/pieces/buanderie-humide/", description: "Linge qui sèche, sèche-linge, machine et ventilation de la pièce.", badge: "Linge" },
];
---
<BaseLayout title="Pièce humide : causes et solutions selon chaque pièce" description="Chambre, salle de bain, cave, placard ou buanderie humide : identifier la cause probable et choisir les actions adaptées à chaque pièce.">
  <div class="container container--wide hub">
    <Breadcrumbs crumbs={[{ label: 'Accueil', href: '/' }, { label: 'Solutions par pièce' }]} />
    <section class="hub-hero">
      <p class="eyebrow">Solutions par pièce</p>
      <h1>Pièce humide : causes et solutions selon chaque pièce</h1>
      <p class="lead">Une pièce humide ne se traite pas au hasard. Dans une salle de bain, la priorité est souvent d’évacuer rapidement la vapeur ; dans une chambre, il faut observer la nuit et le réveil ; dans une cave ou un placard, la température des surfaces et la circulation de l’air deviennent déterminantes.</p>
      <div class="hub-actions"><a class="btn btn--primary" href={`${base}pieces/chambre-humide/`}>Chambre humide</a><a class="btn btn--light" href={`${base}pieces/salle-de-bain-humide/`}>Salle de bain</a></div>
    </section>
    <div class="intro-grid">
      <div class="info-card"><h2>Pièces d’eau</h2><p>Après douche ou bain, le sujet principal est d’évacuer la vapeur assez vite.</p></div>
      <div class="info-card"><h2>Pièces de nuit</h2><p>Dans une chambre, l’humidité se voit souvent le matin : vitres, angles froids, odeur.</p></div>
      <div class="info-card"><h2>Volumes fermés</h2><p>Cave et placard piègent facilement l’air humide. Le rangement compte autant que l’appareil.</p></div>
    </div>
    <div class="section-heading"><h2>Choisir la pièce concernée</h2></div>
    <div class="card-grid">{pieces.map(p => <ArticleCard {...p} />)}</div>

    <section class="diagnostic-section">
      <h2>Reconnaître la cause probable d’une pièce humide</h2>
      <p>Le taux d’humidité seul ne suffit pas. Notez le moment, la durée et l’endroit précis où le problème apparaît. Ces indices permettent de distinguer un excès de vapeur courant d’un défaut qui mérite un diagnostic du bâtiment.</p>
      <div class="table-wrap">
        <table>
          <caption>Symptômes fréquents, causes à vérifier et premières actions</caption>
          <thead><tr><th>Ce que vous observez</th><th>Cause à vérifier en premier</th><th>Première action</th></tr></thead>
          <tbody>
            <tr><td>Buée après douche ou cuisson</td><td>Vapeur produite plus vite qu’elle n’est évacuée</td><td>Aérer brièvement et vérifier l’extraction</td></tr>
            <tr><td>Vitres mouillées surtout le matin</td><td>Air nocturne humide et vitrage froid</td><td>Mesurer au coucher et au réveil, puis calculer le point de rosée</td></tr>
            <tr><td>Angle noir derrière un meuble</td><td>Surface froide et air qui circule mal</td><td>Écarter le meuble, nettoyer prudemment et surveiller</td></tr>
            <tr><td>Trace qui revient après la pluie</td><td>Infiltration possible</td><td>Photographier, repérer le trajet de l’eau et faire contrôler l’enveloppe</td></tr>
            <tr><td>Bas de mur humide ou salpêtre</td><td>Remontées capillaires possibles, infiltration latérale, ruissellement extérieur ou fuite à proximité</td><td>Éviter de masquer la trace et demander un diagnostic adapté</td></tr>
            <tr><td>Odeur dans un placard fermé</td><td>Air stagnant contre une paroi froide</td><td>Vider, sécher, espacer les objets et contrôler le mur</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="protocol-section">
      <h2>Le protocole simple avant d’acheter</h2>
      <ol>
        <li>Placez un hygromètre au centre de la pièce, loin d’une fenêtre, d’un radiateur ou d’une bouche d’air.</li>
        <li>Relevez température et humidité matin et soir pendant trois jours, ainsi qu’après douche, lessive ou cuisson.</li>
        <li>Vérifiez si les entrées et sorties d’air sont ouvertes, propres et réellement fonctionnelles.</li>
        <li>Repérez les surfaces froides et utilisez le <a href={`${base}outils/calculateur-point-de-rosee-condensation/`}>calculateur de point de rosée</a> pour comprendre la condensation.</li>
        <li>Si une trace localisée progresse après la pluie ou résiste à l’aération, recherchez une fuite ou une infiltration avant de choisir un appareil.</li>
      </ol>
      <p><strong>À retenir :</strong> un absorbeur ou un déshumidificateur peut retirer de l’eau de l’air, mais aucun appareil ne répare une entrée d’eau ni une ventilation défectueuse.</p>
    </section>
  </div>
</BaseLayout>

<style>
.hub { padding:2rem 0 3.25rem; }
.hub-hero { background:#fff; border:1px solid var(--color-border); border-radius:20px; padding:clamp(1.25rem,3vw,2rem); box-shadow:0 14px 40px rgba(30,42,58,.06); margin-bottom:2rem; }
.eyebrow { color:var(--color-primary); font-weight:750; text-transform:uppercase; letter-spacing:.06em; font-size:.78rem; margin-bottom:.45rem; }
.lead { color:var(--color-text-muted); font-size:1.08rem; max-width:760px; }
.hub-actions { display:flex; gap:.75rem; flex-wrap:wrap; margin-top:1rem; }
.btn--light { background:#fff; color:var(--color-primary); border:1.5px solid var(--color-primary); }
.intro-grid { display:grid; gap:1rem; margin:1.25rem 0 2rem; }
@media(min-width:760px){ .intro-grid{ grid-template-columns:repeat(3,1fr);} }
.info-card { background:#f7faf8; border:1px solid var(--color-border); border-radius:16px; padding:1rem; }
.info-card h2, .info-card h3 { margin-top:0; font-size:1.05rem; }
.info-card p { color:var(--color-text-muted); font-size:.94rem; margin-bottom:0; }
.section-heading { display:flex; justify-content:space-between; align-items:end; gap:1rem; margin:2rem 0 1rem; }
.section-heading h2 { margin:0; }
.diagnostic-section, .protocol-section { margin-top:2.5rem; max-width:960px; }
.table-wrap { overflow-x:auto; margin:1rem 0 1.5rem; border:1px solid var(--color-border); border-radius:14px; }
table { width:100%; border-collapse:collapse; min-width:700px; background:#fff; }
caption { padding:.75rem .9rem; text-align:left; font-weight:700; background:#fff; }
th, td { padding:.8rem .9rem; text-align:left; vertical-align:top; border-bottom:1px solid var(--color-border); }
th { background:#eef6f1; color:var(--color-text); font-size:.9rem; }
tbody tr:last-child td { border-bottom:0; }
.protocol-section { background:#f7faf8; border:1px solid var(--color-border); border-radius:16px; padding:clamp(1rem,3vw,1.5rem); }
.protocol-section h2 { margin-top:0; }
.protocol-section li + li { margin-top:.5rem; }
@media(max-width:640px){ .hub-actions .btn{width:100%;text-align:center}.section-heading{display:block} }
</style>
