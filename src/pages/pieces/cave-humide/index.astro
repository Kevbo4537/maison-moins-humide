---
import ArticleLayout from '../../../layouts/ArticleLayout.astro';
import AlertBox from '../../../components/AlertBox.astro';
import FAQSection from '../../../components/FAQSection.astro';
import UsefulProductLinks from '../../../components/UsefulProductLinks.astro';
import RevenueProductBlock from '../../../components/RevenueProductBlock.astro';
const base = import.meta.env.BASE_URL;
const faqs = [
  { question: "Une cave humide est-elle normale ?", answer: "Une cave peut être plus fraîche et humide qu’une pièce de vie, mais un taux très élevé, des murs mouillés, du salpêtre ou une odeur forte doivent faire chercher la cause." },
  { question: "Quel appareil choisir pour une cave humide ?", answer: "Un déshumidificateur efficace en pièce fraîche est souvent plus adapté qu’un absorbeur si le volume est important et si le taux reste élevé." },
  { question: "Quand éviter de stocker des affaires dans une cave ?", answer: "Évitez les cartons, textiles et objets sensibles si la cave sent le moisi, si les murs sont humides ou si le taux reste haut malgré l’aération." },
];

const caveProducts = [
  {
    title: 'ThermoPro TP50',
    useCase: 'À placer dans la cave pour suivre le taux plusieurs jours, surtout après pluie ou aération.',
    details: 'La mesure évite de confondre cave fraîche ponctuellement humide et problème durable.',
    href: 'https://amzn.to/4tYqvqt',
    badge: 'Contrôle',
    ctaLabel: 'Voir sur Amazon →',
    imageSrc: 'https://m.media-amazon.com/images/I/61gK5MV3o8L._AC_SL1500_.jpg',
  },
  {
    title: 'KNKA 16 L/jour',
    useCase: 'À regarder pour une cave tempérée ou une buanderie qui reste humide, avec besoin d’assèchement régulier.',
    details: 'Jusqu’à 16 L/jour annoncés à 35 °C et 90 % HR ; l’extraction réelle sera plus faible dans une pièce fraîche ou moins humide. Vérifier la température de la cave.',
    href: 'https://amzn.to/4hnZ5Ym',
    badge: 'Cave / buanderie',
    ctaLabel: 'Voir sur Amazon →',
    imageSrc: 'https://m.media-amazon.com/images/I/619cdHuOH1L._AC_SL1500_.jpg',
  },
  {
    title: 'Rubson Aero 360 + 3 recharges',
    useCase: 'Pour un petit rangement de cave ou une zone fermée légèrement humide, pas pour une cave entière.',
    details: 'Utile en complément local, insuffisant si les murs ou le sol apportent beaucoup d’humidité.',
    href: 'https://amzn.to/4dROwtf',
    badge: 'Petit stockage',
    ctaLabel: 'Voir sur Amazon →',
    imageSrc: 'https://m.media-amazon.com/images/I/61J+W8SeX9L._AC_SL1001_.jpg',
  },
];
---
<ArticleLayout title="Cave humide : que faire avant d’acheter un appareil ?" description="Cave humide, odeur de moisi, cartons abîmés : quoi vérifier avant absorbeur, ventilation ou déshumidificateur." breadcrumbs={[{ label: 'Accueil', href: '/' }, { label: 'Solutions par pièce', href: '/pieces/' }, { label: 'Cave humide : que faire avant d’acheter un appareil ?' }]} showAffiliateDisclosure={true} showAmazon={true}>
  <h1>Cave humide : que faire avant d’acheter un appareil ?</h1>
  <p>Une cave est souvent plus fraîche que le reste de la maison. Avec des murs enterrés, un sol poreux ou peu d’air qui circule, elle peut sentir le moisi sans qu’il y ait forcément une grosse fuite.</p>

  <AlertBox type="tip" title="Premier réflexe">
    <p>Avant d’acheter un appareil, mesurez le taux plusieurs jours et regardez si l’humidité augmente après la pluie.</p>
  </AlertBox>

  <h2>Causes fréquentes</h2>
  <ul>
    <li>murs enterrés froids</li>
    <li>ventilation absente ou insuffisante</li>
    <li>sol ou murs qui laissent passer l’humidité</li>
    <li>objets stockés contre les parois</li>
    <li>infiltration après pluie ou nappe haute</li>
  </ul>
  <h2>Ce qu’il faut observer</h2>
  <ul>
    <li>odeur de moisi persistante</li>
    <li>cartons mous ou textiles qui sentent mauvais</li>
    <li>salpêtre ou poudre blanche sur les murs</li>
    <li>eau visible ou sol mouillé après pluie</li>
    <li>taux élevé même en période sèche</li>
  </ul>
  <h2>Protéger ce qui est stocké</h2>
  <ul>
    <li>éviter les cartons au sol</li>
    <li>laisser un espace entre affaires et murs</li>
    <li>utiliser des bacs plastiques fermés pour le sensible</li>
    <li>ne pas stocker textiles ou papiers longtemps si la cave est humide</li>
    <li>surélever les objets avec étagères ou palettes propres</li>
  </ul>
  <h2>Solutions possibles</h2>
  <ul>
    <li>ventilation naturelle ou mécanique adaptée</li>
    <li>déshumidificateur avec évacuation continue si usage régulier</li>
    <li>recherche d’infiltration si l’eau apparaît après pluie</li>
    <li>drainage ou avis professionnel si problème structurel</li>
  </ul>

  <RevenueProductBlock
    title="Produits utiles pour une cave humide"
    intro="Une cave demande plus de prudence qu’un placard : on mesure, on observe l’eau après la pluie, puis on choisit un produit seulement si le problème n’est pas une infiltration active."
    products={caveProducts}
    note="Si la cave a de l’eau visible, du salpêtre important ou un mur enterré mouillé, un appareil peut aider à assécher l’air mais ne remplace pas un diagnostic bâtiment."
  />

  <AlertBox type="warning" title="À vérifier">
    <p>Un déshumidificateur peut aider une cave, mais s’il y a arrivée d’eau, infiltration ou mur très humide, il ne remplace pas un diagnostic bâtiment.</p>
  </AlertBox>

  <FAQSection items={faqs} />

  <UsefulProductLinks />

  <h2>À lire ensuite</h2>
  <ul>
    <li><a href={`${base}comparatifs/meilleur-deshumidificateur-maison/`}>Déshumidificateur pour cave</a></li>
    <li><a href={`${base}guides/humidite-maison-70-pourcent/`}>Humidité à 70 %</a></li>
    <li><a href={`${base}guides/odeur-humidite-maison/`}>Odeur d’humidité</a></li>
  </ul>
</ArticleLayout>
