---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ArticleCard from '../../components/ArticleCard.astro';
const base = import.meta.env.BASE_URL;
const guides = [
  { title: "Humidité dans la maison : que faire ?", description: "Le guide de départ pour mesurer, observer, ventiler et décider sans acheter au hasard.", href: "/guides/humidite-maison-que-faire/", badge: "Commencer" },
  { title: "Taux d’humidité idéal", description: "Repères 40-60 %, méthode de mesure et interprétation selon la pièce et la saison.", href: "/guides/taux-humidite-ideal-maison/", badge: "Essentiel" },
  { title: "Humidité à 70 %", description: "Savoir si le taux est ponctuel, durable ou lié à une vraie cause à traiter.", href: "/guides/humidite-maison-70-pourcent/" },
  { title: "Moisissure sur un mur", description: "Comprendre les causes possibles, les signes à surveiller et les limites du nettoyage.", href: "/guides/moisissure-mur-danger/", badge: "À surveiller" },
  { title: "Condensation sur les fenêtres", description: "Limiter la buée, l’eau qui ruisselle et les moisissures autour des fenêtres.", href: "/guides/condensation-fenetre/" },
  { title: "Serrure bloquée par l’humidité", description: "Clé qui accroche, porte qui gonfle, cylindre oxydé : comprendre le lien avec l’humidité sans forcer.", href: "/guides/serrure-bloquee-humidite/", badge: "Maison" },
  { title: "Odeur d’humidité", description: "Localiser l’origine d’une odeur de moisi dans une pièce, un placard ou une cave.", href: "/guides/odeur-humidite-maison/" },
];
---
<BaseLayout title="Guides humidité maison : mesurer, comprendre, agir" description="Tous les guides pratiques pour comprendre l’humidité dans une maison, mesurer le taux, limiter condensation, odeurs et moisissures.">
  <div class="container container--wide hub">
    <Breadcrumbs crumbs={[{ label: 'Accueil', href: '/' }, { label: 'Guides humidité' }]} />
    <section class="hub-hero">
      <p class="eyebrow">Guides pratiques</p>
      <h1>Guides humidité maison</h1>
      <p class="lead">Commencez par comprendre ce que vous observez : taux élevé, condensation, moisissure, odeur ou pièce qui sèche mal. Chaque guide donne des actions simples, sans dramatiser et sans promettre de solution miracle.</p>
      <div class="hub-actions"><a class="btn btn--primary" href={`${base}guides/humidite-maison-que-faire/`}>Lire le guide de départ</a><a class="btn btn--light" href={`${base}comparatifs/meilleur-hygrometre-maison/`}>Mesurer correctement</a></div>
    </section>
    <div class="intro-grid">
      <div class="info-card"><h2>1. Mesurer</h2><p>Un hygromètre donne une tendance fiable si vous notez les valeurs plusieurs jours.</p></div>
      <div class="info-card"><h2>2. Identifier</h2><p>Fenêtre, mur, plafond, placard ou cave : la zone touchée oriente la cause.</p></div>
      <div class="info-card"><h2>3. Agir</h2><p>Ventilation, chauffage, produit ou professionnel : la solution dépend de la cause.</p></div>
    </div>
    <div class="section-heading"><h2>Tous les guides</h2></div>
    <div class="card-grid">{guides.map(g => <ArticleCard {...g} />)}</div>
  </div>
</BaseLayout>

<style>
.hub { padding:2rem 0 3.25rem; }
.hub-hero { background:#fff; border:1px solid var(--color-border); border-radius:20px; padding:clamp(1.25rem,3vw,2rem); box-shadow:0 14px 40px rgba(30,42,58,.06); margin-bottom:2rem; }
.eyebrow { color:var(--color-primary); font-weight:750; text-transform:uppercase; letter-spacing:.06em; font-size:.78rem; margin-bottom:.45rem; }
.lead { color:var(--color-text-muted); font-size:1.08rem; max-width:760px; }
.hub-actions { display:flex; gap:.75rem; flex-wrap:wrap; margin-top:1rem; }
.btn--light { background:#fff; color:var(--color-primary); border:1.5px solid var(--color-primary); }
.intro-grid { display:grid; gap:1rem; margin:1.25rem 0 2rem; }
@media(min-width:760px){ .intro-grid{ grid-template-columns:repeat(3,1fr);} }
.info-card { background:#f7faf8; border:1px solid var(--color-border); border-radius:16px; padding:1rem; }
.info-card h2, .info-card h3 { margin-top:0; font-size:1.05rem; }
.info-card p { color:var(--color-text-muted); font-size:.94rem; margin-bottom:0; }
.section-heading { display:flex; justify-content:space-between; align-items:end; gap:1rem; margin:2rem 0 1rem; }
.section-heading h2 { margin:0; }
@media(max-width:640px){ .hub-actions .btn{width:100%;text-align:center}.section-heading{display:block} }
</style>
