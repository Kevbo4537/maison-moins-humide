---
interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  crumbs: Crumb[];
}
const { crumbs } = Astro.props;
const base = import.meta.env.BASE_URL;
const withBase = (href: string) => href === '/' ? base : `${base}${href.replace(/^\//, '')}`;
---
<nav class="breadcrumbs" aria-label="Fil d'Ariane">
  <ol itemscope itemtype="https://schema.org/BreadcrumbList">
    {crumbs.map((crumb, index) => (
      <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
        {crumb.href ? (
          <a href={withBase(crumb.href)} itemprop="item">
            <span itemprop="name">{crumb.label}</span>
          </a>
        ) : (
          <span itemprop="name" aria-current="page">{crumb.label}</span>
        )}
        <meta itemprop="position" content={String(index + 1)} />
        {index < crumbs.length - 1 && <span class="sep" aria-hidden="true">›</span>}
      </li>
    ))}
  </ol>
</nav>

<style>
.breadcrumbs {
  font-size: 0.85rem;
  color: var(--color-text-muted);
  margin-bottom: 1.25rem;
}

.breadcrumbs ol {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 0.25rem;
  align-items: center;
}

.breadcrumbs a {
  color: var(--color-primary);
  text-decoration: none;
}

.breadcrumbs a:hover { text-decoration: underline; }

.sep { margin: 0 0.15rem; color: #aab; }
</style>
