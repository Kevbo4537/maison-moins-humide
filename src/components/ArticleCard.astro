---
interface Props {
  title: string;
  description: string;
  href: string;
  badge?: string;
}
const { title, description, href, badge } = Astro.props;
---
<article class="article-card">
  {badge && <span class="badge">{badge}</span>}
  <h3><a href={href}>{title}</a></h3>
  <p>{description}</p>
  <a href={href} class="card-link" aria-label={`Lire : ${title}`}>Lire le guide →</a>
</article>

<style>
.article-card {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius);
  padding: 1.25rem;
  position: relative;
  transition: box-shadow 0.15s, border-color 0.15s;
}

.article-card:hover {
  border-color: var(--color-primary);
  box-shadow: 0 2px 10px rgba(26, 86, 160, 0.1);
}

.article-card h3 { margin: 0.25rem 0 0.5rem; font-size: 1.05rem; }
.article-card h3 a { color: var(--color-text); text-decoration: none; }
.article-card h3 a:hover { color: var(--color-primary); }

.article-card p { font-size: 0.9rem; color: var(--color-text-muted); margin-bottom: 0.75rem; }

.badge {
  display: inline-block;
  font-size: 0.72rem;
  font-weight: 600;
  padding: 0.2rem 0.55rem;
  border-radius: 20px;
  background: #eef2f7;
  color: var(--color-primary);
  text-transform: uppercase;
  letter-spacing: 0.03em;
  margin-bottom: 0.5rem;
}

.card-link {
  font-size: 0.88rem;
  font-weight: 600;
  color: var(--color-primary);
  text-decoration: none;
}

.card-link:hover { text-decoration: underline; }
</style>
