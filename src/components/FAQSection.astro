---
interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  items: FAQItem[];
  title?: string;
}

const { items, title = 'Questions fréquentes' } = Astro.props;

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---
{items.length > 0 && (
  <section class="faq-section" aria-labelledby="faq-title">
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
    <h2 id="faq-title">{title}</h2>
    <div class="faq-list">
      {items.map((item) => (
        <article class="faq-item">
          <h3>{item.question}</h3>
          <p>{item.answer}</p>
        </article>
      ))}
    </div>
  </section>
)}

<style>
.faq-section {
  margin-top: 2rem;
}

.faq-list {
  display: grid;
  gap: 1rem;
}

.faq-item {
  border: 1px solid var(--color-border);
  border-radius: 1rem;
  padding: 1rem;
  background: var(--color-surface);
}

.faq-item h3 {
  margin-top: 0;
}

.faq-item p {
  margin-bottom: 0;
}
</style>
