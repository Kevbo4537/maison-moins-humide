---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import AffiliateDisclosure from '../components/AffiliateDisclosure.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  breadcrumbs: Array<{ label: string; href?: string }>;
  showAmazon?: boolean;
}

const { title, description, canonical, breadcrumbs, showAmazon = false } = Astro.props;
---
<BaseLayout title={title} description={description} canonical={canonical}>
  <div class="container comparison-wrapper">
    <Breadcrumbs crumbs={breadcrumbs} />
    <AffiliateDisclosure amazon={showAmazon} />
    <article class="prose">
      <slot />
    </article>
  </div>
</BaseLayout>

<style>
.comparison-wrapper {
  padding-top: 2rem;
  padding-bottom: 3rem;
}
</style>
