---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  isHome?: boolean;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
}

const {
  title,
  description,
  canonical,
  isHome = false,
  ogImage = '/images/og-default.jpg',
  ogType = 'website',
  noindex = false,
} = Astro.props;

const siteUrl = 'https://www.maisonmoinshumide.fr';
const canonicalUrl = canonical ?? (siteUrl + Astro.url.pathname);
const base = import.meta.env.BASE_URL;

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteUrl}/#website`,
  name: 'Maison Moins Humide',
  url: siteUrl,
  inLanguage: 'fr-FR',
  description: "Conseils pratiques pour comprendre, mesurer et réduire l'humidité dans votre maison.",
  publisher: { '@id': `${siteUrl}/#organization` },
};

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${siteUrl}/#organization`,
  name: 'Maison Moins Humide',
  url: siteUrl,
  logo: { '@type': 'ImageObject', url: `${siteUrl}/favicon.svg` },
  description: "Site éditorial indépendant consacré à l'humidité dans le logement, à la condensation et à la prévention des moisissures.",
};
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />

  <!-- Open Graph -->
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={siteUrl + ogImage} />
  <meta property="og:image:type" content="image/jpeg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Maison Moins Humide — comprendre et réduire l’humidité dans le logement" />
  <meta property="og:locale" content="fr_FR" />
  <meta property="og:site_name" content="Maison Moins Humide" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={siteUrl + ogImage} />

  {isHome && (
    <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
  )}
</head>
<body>
  <a href="#main-content" class="sr-only">Aller au contenu principal</a>
  <Header />
  <main id="main-content">
    <slot />
  </main>
  <Footer />
  {base !== '/' && (
    <script define:vars={{ base }}>
      for (const link of document.querySelectorAll('a[href^="/"]')) {
        const href = link.getAttribute('href');
        if (href && !href.startsWith(base)) link.setAttribute('href', base.replace(/\/$/, '') + href);
      }
    </script>
  )}
</body>
</html>
