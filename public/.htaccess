RewriteEngine On

# Domaine canonique : HTTPS + www
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^www\.maisonmoinshumide\.fr$ [NC]
RewriteRule ^(.*)$ https://www.maisonmoinshumide.fr/$1 [R=301,L]

# Compatibilité SEO : certains outils cherchent /sitemap.xml
RewriteRule ^sitemap\.xml$ https://www.maisonmoinshumide.fr/sitemap-index.xml [R=301,L]

# Pages propres sans index.html visible
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*/)?index\.html$ https://www.maisonmoinshumide.fr/$1 [R=301,L,NE]

# OVH ajoute parfois :443 lors de sa propre redirection DirectorySlash.
# Traiter explicitement les dossiers sans slash avec l’URL canonique.
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.+)$ https://www.maisonmoinshumide.fr/$1/ [R=301,L,NE]

# Compression navigateur si disponible chez l’hébergeur
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

# Cache des assets versionnés Astro
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>
